# ---- Private Channels ----
# Channel where the ORIGINAL product files (video/pdf/zip/etc) live.
# Bot must be ADMIN of this channel. Use the numeric id, e.g. -1001234567890
STORAGE_CHANNEL_ID=-1004291342703

# Channel where the bot will auto-upload database backups.
# Bot must be ADMIN of this channel too. Can be same as STORAGE_CHANNEL_ID
# but a separate channel is recommended.
BACKUP_CHANNEL_ID=-1004291342703

# ---- Bot Behaviour ----
# How often (in minutes) the bot auto-backs-up the database to BACKUP_CHANNEL_ID
BACKUP_INTERVAL_MINUTES=60

# Default coin reward given to referrer when a referred user makes their first purchase
REFERRAL_REWARD_COIN=20

# Local sqlite file name (kept out of git, restored automatically on boot)
DB_PATH=data/bot.db
